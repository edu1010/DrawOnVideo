{
  "name": "drawonvideo",
  "version": "0.1.0",
  "description": "Desktop app to paint annotations over video with timeline-synced layers",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "react",
    "video",
    "annotation",
    "canvas"
  ],
  "author": "edu1010",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "vite": "^8.0.10",
    "wait-on": "^8.0.2"
  }
}
